# GEMINI_API_KEY: Required for Gemini AI API calls (Concierge & Admin Analytics AI).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL / APP_BASE_URL: Public origin URL (Vercel or Cloud Run).
APP_URL=""
APP_BASE_URL=""
ALLOWED_ORIGINS=""

# Environment & Demo Mode
APP_ENV="development"
DEMO_MODE="true"
EMBEDDED_PREVIEW="auto"

# Security & Cryptographic Secrets (Auto-generated & persisted in development if unset)
ENV_MASTER_SEED=""
SESSION_SECRET=""
QR_HMAC_SECRET=""
WEBHOOK_HMAC_SECRET=""
OTP_PEPPER=""

# PostgreSQL / Vercel Postgres Configuration (Optional in local preview; used in Vercel deployment)
POSTGRES_HOST=""
POSTGRES_PORT="5432"
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE="kaonashi_phygital"
POSTGRES_SSL="true"

# Optional Integrations (Fall back to clearly labelled SIMULATED adapters when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
VITE_STRIPE_PUBLISHABLE_KEY=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
